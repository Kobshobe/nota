# 服务端（复制为 .env；.env 不入库）
PORT=8080
DATABASE_PATH=./data/nota.db
JWT_SECRET=
JWT_EXPIRES_IN=7d
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 会议录音转写（MiniMax ASR）：key 只在服务端
MINIMAX_API_KEY=
MINIMAX_ASR_BASE_URL=https://api.minimax.cn
MINIMAX_ASR_MODEL=asr-1.0
# 设备语音（模拟器）：上限、TTS、临时文件
DEVICE_MAX_SECONDS=60
DEVICE_MAX_BYTES=5242880
DEVICE_UPLOADS_PATH=./data/device-uploads
MINIMAX_TTS_BASE_URL=https://api.minimax.cn
MINIMAX_TTS_MODEL=speech-2.8-hd
MINIMAX_TTS_VOICE=female-yujie
TTS_MAX_CHARS=200
TTS_PATH=./data/tts
TTS_RETENTION_HOURS=1
RECORDING_MAX_SECONDS=480
RECORDING_MAX_BYTES=12582912
RECORDING_RETENTION_HOURS=24
DAILY_LIMIT=10
QUOTA_TIMEZONE=Asia/Shanghai
# 日志：pretty（默认，人类可读）/ json（pino 原始行）；级别 fatal|error|warn|info|debug|trace|silent
LOG_FORMAT=pretty
LOG_LEVEL=info

# Flutter 客户端（flutter run --dart-define=API_BASE_URL=...）
API_BASE_URL=http://127.0.0.1:8080
